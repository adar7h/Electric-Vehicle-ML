import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler, LabelEncoder
from sklearn.linear_model import LinearRegression, LogisticRegression
from sklearn.cluster import KMeans
from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score
from sklearn.metrics import accuracy_score, confusion_matrix
from scipy.cluster.hierarchy import dendrogram, linkage

a = pd.read_csv("/mnt/data/Electric_Vehicle_Population_Data (1).csv")
a = a.dropna()

le = LabelEncoder()
a['Make'] = le.fit_transform(a['Make'])
a['Model'] = le.fit_transform(a['Model'])
a['Electric Vehicle Type'] = le.fit_transform(a['Electric Vehicle Type'])

plt.figure()
a['Model Year'].value_counts().sort_index().plot(kind='bar')
plt.title("EV Count by Model Year")
plt.xlabel("Model Year")
plt.ylabel("Count")
plt.show()

plt.figure()
plt.hist(a['Electric Range'], bins=20)
plt.title("Distribution of Electric Range")
plt.xlabel("Electric Range")
plt.ylabel("Frequency")
plt.show()

plt.figure()
a['Make'].value_counts().head(10).plot(kind='bar')
plt.title("Top 10 EV Makes")
plt.xlabel("Make")
plt.ylabel("Count")
plt.show()

plt.figure()
plt.scatter(a['Model Year'], a['Electric Range'])
plt.title("Electric Range vs Model Year")
plt.xlabel("Model Year")
plt.ylabel("Electric Range")
plt.show()

b = a[['Model Year', 'Make', 'Model']]
c = a['Electric Range']

sc = StandardScaler()
b = sc.fit_transform(b)

x_train, x_test, y_train, y_test = train_test_split(
    b, c, test_size=0.2, random_state=42
)

lr = LinearRegression()
lr.fit(x_train, y_train)
y_pred = lr.predict(x_test)

print("\n--- Linear Regression ---")
print("MAE:", mean_absolute_error(y_test, y_pred))
print("RMSE:", np.sqrt(mean_squared_error(y_test, y_pred)))
print("R2:", r2_score(y_test, y_pred))

plt.figure()
plt.scatter(y_test, y_pred)
plt.title("Actual vs Predicted Electric Range")
plt.xlabel("Actual")
plt.ylabel("Predicted")
plt.show()

plt.figure()
plt.hist(y_test - y_pred, bins=20)
plt.title("Regression Error Distribution")
plt.xlabel("Error")
plt.ylabel("Frequency")
plt.show()

a['High_Range'] = np.where(a['Electric Range'] > 100, 1, 0)

x = a[['Model Year', 'Make']]
y = a['High_Range']

x = sc.fit_transform(x)

x_train, x_test, y_train, y_test = train_test_split(
    x, y, test_size=0.2, random_state=42
)

log = LogisticRegression()
log.fit(x_train, y_train)
y_pred = log.predict(x_test)

print("\n--- Logistic Regression ---")
print("Accuracy:", accuracy_score(y_test, y_pred))
print("Confusion Matrix:\n", confusion_matrix(y_test, y_pred))

cm = confusion_matrix(y_test, y_pred)
plt.figure()
plt.imshow(cm)
plt.title("Confusion Matrix")
plt.xlabel("Predicted")
plt.ylabel("Actual")
plt.colorbar()
plt.show()

kmeans = KMeans(n_clusters=3, random_state=42)
clusters = kmeans.fit_predict(b)

plt.figure()
plt.scatter(b[:, 0], b[:, 1], c=clusters)
plt.title("K-Means Clustering")
plt.xlabel("Feature 1")
plt.ylabel("Feature 2")
plt.show()

wcss = []
for i in range(1, 8):
    km = KMeans(n_clusters=i, random_state=42)
    km.fit(b)
    wcss.append(km.inertia_)

plt.figure()
plt.plot(range(1, 8), wcss, marker='o')
plt.title("Elbow Method")
plt.xlabel("Number of Clusters")
plt.ylabel("WCSS")
plt.show()

linked = linkage(b[:150], method='ward')

plt.figure(figsize=(10, 5))
dendrogram(linked)
plt.title("Hierarchical Clustering Dendrogram")
plt.xlabel("Data Points")
plt.ylabel("Distance")
plt.show()